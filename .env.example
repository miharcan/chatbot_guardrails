OPENAI_API_KEY=your_key_here
OPENAI_GUARD_MODEL=gpt-4.1-mini

# Comma-separated keys allowed to call /decide via X-API-Key.
API_KEYS=key_public_1,key_public_2,key_internal_1

# Subset of API_KEYS that may call mode=auto or mode=llm.
PRIVILEGED_API_KEYS=key_internal_1

# Optional backward-compatible bearer auth token.
API_AUTH_TOKEN=

# Request guards
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TEXT_CHARS=2000
